{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@plannotator/opencode@latest"],
  "formatter": {
    "eslint": {
      "command": ["pnpm", "exec", "eslint", "--fix", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx"]
    },
    "prettier": {
      "command": ["pnpm", "exec", "prettier", "--write", "$FILE"],
      "extensions": [".json", ".css", ".scss", ".md", ".html"]
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp", "--api-key", "{env:CONTEXT_7_API_KEY}"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "ask",
      "npm *": "ask",
      "yarn *": "ask",
      "pnpm *": "ask",
      "rm *": "ask"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
